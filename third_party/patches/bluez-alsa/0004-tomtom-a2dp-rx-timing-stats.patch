+static long long tomtom_timespec_diff_us(
+		const struct timespec *a, const struct timespec *b) {
+	return (long long)(b->tv_sec - a->tv_sec) * 1000000LL +
+			(long long)(b->tv_nsec - a->tv_nsec) / 1000LL;
+}
