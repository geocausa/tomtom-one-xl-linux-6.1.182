+/*
+ * Early on-screen debug console: writes into the framebuffer the TomTom
+ * bootloader left configured. The bootloader's LCD controller keeps scanning
+ * that address, so text appears on screen without any kernel fb driver.
+ * The region is reserved from the allocator so it can never corrupt
+ * live kernel/user memory.
+ */
+extern unsigned long tomtom_fb_phys;
+
+#define TT_FB_SIZE	(480 * 272 * 2)
+static int ttfb_x, ttfb_y;
+static u16 __iomem *ttfb_base;
+
+static void ttfb_scroll_up(void)
+{
+	int i;
+	/* Scroll 16 text lines (16 * 16 * 480 = 122,880 pixels) */
+	for (i = 0; i < 16 * 16 * 480; i++)
+		ttfb_base[i] = ttfb_base[i + 16 * 480];
+	/* Clear bottom line 16 (16 * 480 = 7,680 pixels) */
+	for (i = 16 * 16 * 480; i < 17 * 16 * 480; i++)
+		ttfb_base[i] = 0x0000;
+	ttfb_y = 16;
+}
+
+static void ttfb_newline(void)
+{
+	ttfb_x = 0;
+	if (++ttfb_y >= 17)
+		ttfb_scroll_up();
+}
+
+static void ttfb_putchar(char c)
+{
+	int row, col;
+	if (!ttfb_base)
+		return;
+	switch (c) {
+	case '\n': ttfb_newline(); return;
+	case '\r': ttfb_x = 0; return;
+	case '\t':
+		ttfb_x = (ttfb_x + 4) & ~3;
+		if (ttfb_x >= 60) ttfb_newline();
+		return;
+	}
+	if (ttfb_x >= 60)
+		ttfb_newline();
+	{
+		const unsigned char *glyph = font_vga_8x16.data + (unsigned char)c * 16;
+		u16 *dst = ttfb_base + (ttfb_y * 16) * 480 + ttfb_x * 8;
+		for (row = 0; row < 16; row++) {
+			unsigned char bits = glyph[row];
+			for (col = 0; col < 8; col++)
+				dst[row * 480 + col] = (bits & (0x80 >> col)) ? 0xFFFF : 0x0000;
+		}
+	}
+	ttfb_x++;
+}
+
+static bool ttfb_active = false;
+
+static void ttfb_console_write(struct console *con, const char *s, unsigned int n)
+{
+	if (!ttfb_active || !ttfb_base)
+		return;
+	while (n--)
+		ttfb_putchar(*s++);
+}
+
+static struct console ttfb_console = {
+	.name	= "ttfb",
+	.write	= ttfb_console_write,
+	.flags	= CON_PRINTBUFFER | CON_ENABLED | CON_ANYTIME,
+	.index	= -1,
+};
+
+/*
+ * Panic-time truth screen: paints the last lines of the kernel ring buffer
+ * directly into the framebuffer, bypassing the console layer completely.
+ */
+static void tt_panic_dump(struct kmsg_dumper *d, enum kmsg_dump_reason reason)
+{
+	static char lines[256][61];
+	static int idx;
+	struct kmsg_dump_iter iter;
+	char buf[64];
+	size_t len = 0;
+	int row, col, i, start;
+
+	if (!ttfb_base)
+		return;
+
+	kmsg_dump_rewind(&iter);
+	while (kmsg_dump_get_line(&iter, false, buf, sizeof(buf) - 1, &len)) {
+		if (len > 60)
+			len = 60;
+		memcpy(lines[idx % 256], buf, len);
+		lines[idx % 256][len] = '\0';
+		idx++;
+	}
+
+	/* Prefer: sysctl failure -> first oops -> tail */
+	start = 0;
+	if (idx > 17) {
+		for (i = idx - 1; i >= 0 && i >= idx - 256; i--) {
+			if (strstr(lines[i % 256], "SYSCTL: register failed") ||
+			    strstr(lines[i % 256], "sysctl table check failed")) {
+				start = (i > 1) ? i - 2 : 0;
+				break;
+			}
+		}
+		if (!start) {
+			for (i = idx - 1; i >= 0 && i >= idx - 256; i--) {
+				if (strstr(lines[i % 256], "Internal error") ||
+				    strstr(lines[i % 256], "Oops")) {
+					start = (i > 1) ? i - 2 : 0;
+					break;
+				}
+			}
+		}
+		if (!start)
+			start = idx - 17;
+	}
+
+	for (row = 0; row < 17; row++)
+		for (col = 0; col < 480; col++)
+			ttfb_base[row * 16 * 480 + col] = 0x0000;
+
+	for (i = start; i < idx && (i - start) < 17; i++) {
+		int srow = (i - start) * 16;
+		char *s = lines[i % 256];
+		for (col = 0; s[col] && col < 60; col++) {
+			const unsigned char *g = font_vga_8x16.data +
+						 (unsigned char)s[col] * 16;
+			int r, c;
+			for (r = 0; r < 16; r++) {
+				unsigned char bits = g[r];
+				u16 *dst = ttfb_base + srow * 480 + col * 8;
+				for (c = 0; c < 8; c++)
+					dst[r * 480 + c] =
+						(bits & (0x80 >> c)) ? 0xffff : 0x0000;
+			}
+		}
+	}
+}
