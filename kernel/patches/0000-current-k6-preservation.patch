+/*
+ * TomTom ONE XL (Limerick) reboot:
+ *
+ * Hardware tests showed INFORM0=NEUTRAL followed by S3C2412 SWRST powers the
+ * unit off, while ARM soft_restart(0) freezes because address 0 is not a live
+ * bootloader re-entry point after Linux handover.
+ *
+ * The original TomTom 2.6 wake path also defines SFTRST (INFORM0=0x9) and uses
+ * it for a simulated wake/restart on S3C2412.  Use that original semantic here
+ * with the original cache-resident S3C2412 reset stub.
+ */
+extern void s3c2412_cpu_reboot(void);
+
+static void tomtom_sftrst_reboot(void)
+{
+	pr_notice("TT: TomTom S3C2412 SFTRST reboot (INFORM0=0x9)\n");
+	writel(0x9, S3C24XX_VA_CLKPWR + 0x70);
+	s3c2412_cpu_reboot();
+
+	while (1)
+		cpu_relax();
+}
+
+static int tomtom_restart_handler(struct notifier_block *this,
+				  unsigned long mode, void *cmd)
+{
+	tomtom_sftrst_reboot();
+	return NOTIFY_DONE;
+}
