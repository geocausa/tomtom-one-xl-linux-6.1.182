+static void __init tomtom_map_io(void)
+{
+	unsigned long kstart = PHYS_OFFSET + 0x8000;
+	unsigned long kend = __pa(_end);
+	bool overlap;
+
+	overlap = tomtom_fb_phys < kend && (tomtom_fb_phys + TT_FB_SIZE) > kstart;
+
+	/* Only hook the debug console if the fb cannot clobber the kernel */
+	if (!overlap && tomtom_fb_phys >= 0x30100000 && tomtom_fb_phys < 0x32000000) {
+		int i;
+		memblock_reserve(tomtom_fb_phys & PAGE_MASK, TT_FB_SIZE);
+		ttfb_base = (u16 *)(0xc0000000 + (tomtom_fb_phys - 0x30000000));
+		/* Clear entire screen to solid black */
+		for (i = 0; i < 480 * 272; i++)
+			ttfb_base[i] = 0x0000;
+		ttfb_x = ttfb_y = 0;
+		ttfb_active = true;
+		register_console(&ttfb_console);
+		kmsg_dump_register(&tt_kmsg_dumper);
+	}
+
+	s3c24xx_init_io(tomtom_iodesc, ARRAY_SIZE(tomtom_iodesc));
+	s3c2412_init_uarts(tomtom_uartcfgs, ARRAY_SIZE(tomtom_uartcfgs));
+	s3c24xx_set_timer_source(S3C24XX_PWM3, S3C24XX_PWM4);
+}
