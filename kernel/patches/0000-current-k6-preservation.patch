+#define GPIO_DRIVER_MAGIC	'U'
+#define IOR_HWSTATUS		_IOR(GPIO_DRIVER_MAGIC, 0, unsigned int)
+#define IOR_BT_MODE		_IOR(GPIO_DRIVER_MAGIC, 8, unsigned int)
+
+static long tomtom_hwstatus_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	/* IOR_BT_MODE: 0x80045508 */
+	if (cmd == IOR_BT_MODE || (cmd & 0xffff) == 0x5508) {
+		unsigned int mode = 1;
+		if (arg) {
+			if (copy_from_user(&mode, (void __user *)arg, sizeof(mode)))
+				return -EFAULT;
+		}
+		pr_notice("TT: Resetting CSR Bluetooth chip (GPA19 toggle, mode=%u)...\n", mode);
+		/* Match the original TomTom 2.6 IOR_BT_MODE path for Limerick:
+		 * this ioctl controls BT_MODE (not populated on this board) and BT_RESET.
+		 * Do not repurpose GPS power or Bluetooth flow-control pins here. */
+
+		s3c_gpio_cfgpin(S3C2410_GPA(19), S3C_GPIO_OUTPUT);
+		gpio_set_value(S3C2410_GPA(19), 0); /* Assert Reset (LOW) */
+		mdelay(10);
+		gpio_set_value(S3C2410_GPA(19), 1); /* Deassert Reset (HIGH) */
+		mdelay(10);
+		gpio_set_value(S3C2410_GPA(19), 0); /* Pulse Reset (LOW) */
+		mdelay(10);
+		gpio_set_value(S3C2410_GPA(19), 1); /* Release Reset (HIGH) */
+		mdelay(100);
+		return 0;
+	}
+
+	if (cmd == IOR_HWSTATUS || (cmd & 0xffff) == 0x5500) {
+		if (arg) {
+			unsigned int status = 0;
+			if (copy_to_user((void __user *)arg, &status, sizeof(status)))
+				return -EFAULT;
+		}
+		return 0;
+	}
+
+	return 0;
+}
