+/*
+ * Dedicated Hardware-Polled Power Button for TomTom ONE XL
+ *
+ * GPF0 connects to the physical top power button.
+ * Automatically learns the idle level at startup, then detects transitions.
+ * Logs any changes to GPFDAT for hardware diagnostics.
+ */
+static struct input_dev *tomtom_pwr_dev;
+static struct timer_list tomtom_pwr_timer;
+static int tomtom_pwr_idle_state = -1;
+static int tomtom_pwr_last_pressed = 0;
+static unsigned long tomtom_last_gpfdat = 0;
+
+static void tomtom_pwr_timer_fn(struct timer_list *t)
+{
+	unsigned long gpfdat = __raw_readl(S3C2410_GPFDAT);
+	int cur_bit = (gpfdat & (1 << 0)) ? 1 : 0;
+
+	if (tomtom_pwr_idle_state < 0) {
+		/* Learn resting/unpressed state at startup */
+		tomtom_pwr_idle_state = cur_bit;
+		tomtom_last_gpfdat = gpfdat;
+		pr_notice("TT: Power button idle level = %d (GPFDAT=0x%04lx)\n",
+			  cur_bit, gpfdat & 0xffff);
+	}
+
+	/* Log any state transitions on GPFDAT */
+	if ((gpfdat & 0xff) != (tomtom_last_gpfdat & 0xff)) {
+		pr_notice("TT: GPFDAT changed: 0x%04lx -> 0x%04lx\n",
+			  tomtom_last_gpfdat & 0xffff, gpfdat & 0xffff);
+		tomtom_last_gpfdat = gpfdat;
+	}
+
+	int pressed = (cur_bit != tomtom_pwr_idle_state);
+
+	if (pressed != tomtom_pwr_last_pressed) {
+		tomtom_pwr_last_pressed = pressed;
+		input_report_key(tomtom_pwr_dev, KEY_POWER, pressed);
+		input_sync(tomtom_pwr_dev);
+		pr_notice("TT: Power button %s (cur=%d, idle=%d, GPFDAT=0x%04lx)\n",
+			  pressed ? "PRESSED" : "RELEASED", cur_bit, tomtom_pwr_idle_state, gpfdat & 0xffff);
+	}
+
+	mod_timer(&tomtom_pwr_timer, jiffies + msecs_to_jiffies(30));
+}
+
+static int __init tomtom_init_power_button(void)
+{
+	int error;
+
+	/* Configure GPF0 as input with pull-down disabled (uses board pull-up) */
+	s3c_gpio_cfgpin(S3C2410_GPF(0), S3C_GPIO_INPUT);
+	__raw_writel(__raw_readl(S3C2410_GPFUP) | (1 << 0), S3C2410_GPFUP);
+
+	tomtom_pwr_dev = input_allocate_device();
+	if (!tomtom_pwr_dev) {
+		pr_err("TT: Failed to allocate power button input device\n");
+		return -ENOMEM;
+	}
+
+	tomtom_pwr_dev->name = "TomTom Power Button";
+	tomtom_pwr_dev->phys = "tomtom/power0";
+	tomtom_pwr_dev->id.bustype = BUS_HOST;
+	tomtom_pwr_dev->id.vendor = 0x0001;
+	tomtom_pwr_dev->id.product = 0x0001;
+	tomtom_pwr_dev->id.version = 0x0100;
+
+	set_bit(EV_KEY, tomtom_pwr_dev->evbit);
+	set_bit(KEY_POWER, tomtom_pwr_dev->keybit);
+
+	error = input_register_device(tomtom_pwr_dev);
+	if (error) {
+		pr_err("TT: Failed to register power button input device: %d\n", error);
+		input_free_device(tomtom_pwr_dev);
+		return error;
+	}
+
+	timer_setup(&tomtom_pwr_timer, tomtom_pwr_timer_fn, 0);
+	mod_timer(&tomtom_pwr_timer, jiffies + msecs_to_jiffies(50));
+
+	pr_notice("TT: Direct hardware polled power button registered on GPF0\n");
+	return 0;
+}
+late_initcall(tomtom_init_power_button);
