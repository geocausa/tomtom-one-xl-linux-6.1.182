+static struct notifier_block tomtom_restart_nb = {
+	.notifier_call = tomtom_restart_handler,
+	.priority = 255,
+};
+
+static void tomtom_restart(enum reboot_mode mode, const char *cmd)
+{
+	tomtom_sftrst_reboot();
+}
