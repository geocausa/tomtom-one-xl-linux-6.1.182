+static void __init tomtom_machine_init(void)
+{
+	pr_notice("TT: machine_init reached\n");
+	/* 1. USB Mode: Switch USB port to peripheral (device) mode */
+	s3c2410_modify_misccr(S3C2410_MISCCR_USBHOST |
+			      S3C2410_MISCCR_USBSUSPND0 |
+			      S3C2410_MISCCR_USBSUSPND1, 0x0);
+	{
+		struct clk *c1 = clk_get(NULL, "usb-device");
+		if (!IS_ERR(c1)) clk_prepare_enable(c1);
+		struct clk *c2 = clk_get(NULL, "usb-bus-gadget");
+		if (!IS_ERR(c2)) clk_prepare_enable(c2);
+	}
+	pr_notice("TT: step1 misccr done\n");
+
+	pr_notice("TT: step2 gpio rails\n");
+	/* Power Button: GPF0 input */
+	s3c_gpio_cfgpin(S3C2410_GPF(0), S3C_GPIO_INPUT);
+	/* USB Power / Host Detect: GPF1 input */
+	s3c_gpio_cfgpin(S3C2410_GPF(1), S3C_GPIO_INPUT);
+	/* Disable internal pull-downs on GPF0 and GPF1 (board has external pull-ups) */
+	__raw_writel(__raw_readl(S3C2410_GPFUP) | (1 << 0) | (1 << 1), S3C2410_GPFUP);
+
+	/* Mask ALL external interrupts in EINTMASK (bits 0..23 = 1) */
+	__raw_writel(0x00ffffff, S3C2410_GPIOREG(0xb4));
+	__raw_writel(0x00ffffff, S3C2410_GPIOREG(0xb8)); /* Clear any pending status */
+
+	/* MOVI_PWR_ON: GPA20 -> 1 (Internal MOVINAND Storage Power) */
+	s3c_gpio_cfgpin(S3C2410_GPA(20), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPA(20), 1);
+
+	/* SD_PWR_ON: GPC6 -> 1 (Storage Power Rail) */
+	s3c_gpio_cfgpin(S3C2410_GPC(6), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPC(6), 1);
+
+	/* EN_SD: GPB1 -> 0 (SD/MMC Bus Enable active-low on Limerick) */
+	s3c_gpio_cfgpin(S3C2410_GPB(1), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPB(1), 0);
+
+	/* SW_SD: GPG11 -> 1 (Select Internal MOVINAND storage) */
+	s3c_gpio_cfgpin(S3C2410_GPG(11), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPG(11), 1);
+
+	/* PULLUP_SD: GPB9 -> 1 (SD Bus Pull-up enable) */
+	s3c_gpio_cfgpin(S3C2410_GPB(9), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPB(9), 1);
+
+	pr_notice("TT: step3 lcd power\n");
+	/* 3. LCD Power, Reset, and Backlight */
+	{
+		struct clk *lcd_clk = clk_get(NULL, "lcd");
+		if (!IS_ERR(lcd_clk)) {
+			clk_prepare_enable(lcd_clk);
+			pr_notice("TT: lcd clock locked active\n");
+		}
+	}
+
+	/* LCD_VCC_PWREN: GPG4 -> 0 (Active Low on Limerick) */
+	s3c_gpio_cfgpin(S3C2410_GPG(4), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPG(4), 0);
+
+	pr_notice("TT: step4 touchscreen pins\n");
+	/* 
+	 * TomTom ONE XL Resistive Touchscreen GPIOs (GPG12-15):
+	 * GPG12: XPON, GPG13: XMON, GPG14: YPON, GPG15: YMON
+	 * Managed by tomtom_ts driver via standard GPIO direction toggling.
+	 * Disable internal pull-ups so they don't skew analog resistance readings.
+	 */
+	s3c_gpio_cfgpin(S3C2410_GPG(12), S3C_GPIO_INPUT);
+	s3c_gpio_cfgpin(S3C2410_GPG(13), S3C_GPIO_INPUT);
+	s3c_gpio_cfgpin(S3C2410_GPG(14), S3C_GPIO_INPUT);
+	s3c_gpio_cfgpin(S3C2410_GPG(15), S3C_GPIO_INPUT);
+
+	{
+		unsigned int gpgup = __raw_readl(S3C2410_GPGUP);
+		gpgup |= (1 << 12) | (1 << 13) | (1 << 14) | (1 << 15);
+		__raw_writel(gpgup, S3C2410_GPGUP);
+	}
+
+	/* Reference voltage for ADC (AIN4_PWR): GPA12 -> 1 */
+	s3c_gpio_cfgpin(S3C2410_GPA(12), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPA(12), 1);
+
+	/* Enable ADC peripheral clock in CLKCON (bit 24 on S3C2412) */
+	__raw_writel(__raw_readl(S3C2410_CLKCON) | (1 << 24), S3C2410_CLKCON);
+
+	/* LCD_RESET: GPF5 -> 1 (Deassert Reset) */
+	s3c_gpio_cfgpin(S3C2410_GPF(5), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPF(5), 1);
+
+	/* Backlight: GPB0 -> 1 (Backlight ON) */
+	s3c_gpio_cfgpin(S3C2410_GPB(0), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPB(0), 1);
+
+	/* Configure SDI / MMC pins (GPE5..GPE10) */
+	s3c_gpio_cfgpin_range(S3C2410_GPE(5), 6, S3C_GPIO_SFN(2));
+
+	pr_notice("TT: step4 audio\n");
+	/* 4. Audio & Codec */
+	/* Audio amplifier enable: GPF6 -> 1 */
+	s3c_gpio_cfgpin(S3C2410_GPF(6), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPF(6), 1);
+
+	/* DAC power: GPE13 -> 1 */
+	s3c_gpio_cfgpin(S3C2410_GPE(13), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPE(13), 1);
+
+	/* Configure I2S pins (GPE0..GPE4) */
+	s3c_gpio_cfgpin_range(S3C2410_GPE(0), 5, S3C_GPIO_SFN(2));
+
+	pr_notice("TT: step5 bt & uarts\n");
+	/* UART0: GPH2 (TXD0), GPH3 (RXD0) */
+	s3c_gpio_cfgpin(S3C2410_GPH(2), S3C_GPIO_SFN(2));
+	s3c_gpio_cfgpin(S3C2410_GPH(3), S3C_GPIO_SFN(2));
+
+	/* UART1: GPH4 (TXD1), GPH5 (RXD1) */
+	s3c_gpio_cfgpin(S3C2410_GPH(4), S3C_GPIO_SFN(2));
+	s3c_gpio_cfgpin(S3C2410_GPH(5), S3C_GPIO_SFN(2));
+
+	/* UART2: GPH6 (TXD2), GPH7 (RXD2) - CSR BlueCore 3 Bluetooth */
+	s3c_gpio_cfgpin(S3C2410_GPH(6), S3C_GPIO_SFN(2));
+	s3c_gpio_cfgpin(S3C2410_GPH(7), S3C_GPIO_SFN(2));
+	s3c_gpio_setpull(S3C2410_GPH(7), S3C_GPIO_PULL_UP);
+
+	/* BT Flow control lines:
+	 * CTS_BT (GPG0): Host output driven LOW (0V = clear to send to CSR)
+	 * RTS_BT (GPG1): CSR output -> Host input
+	 */
+	s3c_gpio_cfgpin(S3C2410_GPG(0), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPG(0), 0);
+	s3c_gpio_setpull(S3C2410_GPG(0), S3C_GPIO_PULL_NONE);
+
+	s3c_gpio_cfgpin(S3C2410_GPG(1), S3C_GPIO_INPUT);
+	s3c_gpio_setpull(S3C2410_GPG(1), S3C_GPIO_PULL_NONE);
+
+	/* BT_RESET: GPA19 -> 1 (Release Reset / Normal Operation) */
+	s3c_gpio_cfgpin(S3C2410_GPA(19), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPA(19), 1);
+
+	/* 6. GPS chip held in reset, but GPF4 power rail enabled for BT / 26MHz clock
+	 * GPS_RESET: GPC5 -> 0 (asserted; active-low on Limerick keeps SiRF chip in reset) */
+	s3c_gpio_cfgpin(S3C2410_GPC(5), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPC(5), 0);
+
+	/* GPS_POWERON_OUT: GPF3 -> 0 */
+	s3c_gpio_cfgpin(S3C2410_GPF(3), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPF(3), 0);
+
+	/* GPS_ON / RF_ON: GPF4 -> 1 (enables RF power rail and 26MHz TCXO clock) */
+	s3c_gpio_cfgpin(S3C2410_GPF(4), S3C_GPIO_OUTPUT);
+	gpio_set_value(S3C2410_GPF(4), 1);
+
+	pr_notice("TT: step7 platdata\n");
+	/* Register Platform Data */
+	gpiod_add_lookup_table(&tomtom_mci_gpio_table);
+	s3c24xx_mci_set_platdata(&tomtom_mci_pdata);
+
+	gpiod_add_lookup_table(&tomtom_udc_gpio_table);
+	s3c24xx_udc_set_platdata(&tomtom_udc_cfg);
+
+	s3c24xx_fb_set_platdata(&tomtom_fb_info);
+	s3c24xx_ts_set_platdata(&tomtom_ts_cfg);
+	s3c_device_ts.dev.parent = NULL;
+
+	s3c_i2c0_set_platdata(NULL);
+
+	gpiod_add_lookup_table(&tomtom_wm8711_spi_gpios);
+	spi_register_board_info(tomtom_wm8711_spi_dev,
+				ARRAY_SIZE(tomtom_wm8711_spi_dev));
+
+	tomtom_audio_board_setup();
+
+	pr_notice("TT: step8 adding devices\n");
+	{
+		int i;
+		for (i = 0; i < ARRAY_SIZE(tomtom_devices); i++) {
+			int ret = platform_device_register(tomtom_devices[i]);
+			if (ret)
+				pr_err("TT: device %s register failed: %d\n", tomtom_devices[i]->name, ret);
+			else
+				pr_notice("TT: device %s registered ok\n", tomtom_devices[i]->name);
+		}
+	}
+	pm_power_off = tomtom_power_off;
+	register_restart_handler(&tomtom_restart_nb);
+}
+
+MACHINE_START(TOMTOMGO, "TomTom GO")
+	.atag_offset	= 0x0,
+	.nr_irqs	= (S3C2410_IRQSUB(28) + 1),
+	.fixup		= tomtom_fixup,
+	.init_irq	= s3c2412_init_irq,
+	.map_io		= tomtom_map_io,
+	.init_machine	= tomtom_machine_init,
+	.init_time	= tomtom_init_time,
+	.restart	= tomtom_restart,
+MACHINE_END
+
+static int __init tt_alive_arch(void) { pr_notice("TT: alive at arch_initcall\n"); return 0; }
+arch_initcall(tt_alive_arch);
+static int __init tt_alive_subsys(void) { pr_notice("TT: alive at subsys_initcall\n"); return 0; }
+subsys_initcall(tt_alive_subsys);
+static int __init tt_alive_fs(void) { pr_notice("TT: alive at fs_initcall\n"); return 0; }
+fs_initcall(tt_alive_fs);
+static int __init tt_alive_device(void) { pr_notice("TT: alive at device_initcall\n"); return 0; }
+device_initcall(tt_alive_device);
+static int __init tt_alive_late(void)
+{
+	pr_notice("TT: alive at late_initcall, unregistering ttfb console for userspace GUI\n");
+	ttfb_active = false;
+	unregister_console(&ttfb_console);
+	return 0;
+}
+late_initcall_sync(tt_alive_late);
--- a/sound/soc/samsung/tomtom_wm8711.c
+++ b/sound/soc/samsung/tomtom_wm8711.c
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-2.0
+//
+// ASoC machine driver for TomTom ONE XL (Limerick)
+// Samsung S3C2412 + Wolfson WM8711
+//
+// Hardware behavior is derived from TomTom's Linux 2.6 GPL sound driver.
+
+#include <linux/module.h>
+#include <linux/delay.h>
+#include <linux/clk.h>
+#include <linux/platform_device.h>
+
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include <asm/mach-types.h>
+
+#include "s3c2412-i2s.h"
+#include "../codecs/wm8711.h"
+
+static int tomtom_calc_rate(struct s3c_i2sv2_rate_calc *best,
+			    unsigned int rate, struct clk *clk)
+{
+	static const unsigned int fs_table[] = { 256, 384 };
+	unsigned long clkrate = clk_get_rate(clk);
+	unsigned int best_diff = ~0U;
+	unsigned int i;
+
+	best->fs_div = 0;
+	best->clk_div = 0;
+
+	for (i = 0; i < ARRAY_SIZE(fs_table); i++) {
+		unsigned int fs = fs_table[i];
+		unsigned long denom = (unsigned long)fs * rate;
+		unsigned int div;
+		unsigned int actual;
+		unsigned int diff;
+
+		if (!denom)
+			continue;
+
+		/* Same nearest-divider policy as TomTom's 2.6 iis-s3c2412.c. */
+		div = (clkrate + denom / 2) / denom;
+		if (div < 1 || div > 32)
+			continue;
+
+		actual = clkrate / ((unsigned long)fs * div);
+		diff = (actual > rate) ? actual - rate : rate - actual;
+
+		if (diff < best_diff) {
+			best_diff = diff;
+			best->fs_div = fs;
+			best->clk_div = div;
+		}
+	}
+
+	if (!best->fs_div)
+		return -EINVAL;
+
+	pr_info("TomTom ASoC: PCLK=%lu requested=%u fs=%u div=%u real=%lu\n",
+		clkrate, rate, best->fs_div, best->clk_div,
+		clkrate / ((unsigned long)best->fs_div * best->clk_div));
+
+	return 0;
+}
+
+static int tomtom_wm8711_hw_params(struct snd_pcm_substream *substream,
+				    struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = asoc_substream_to_rtd(substream);
+	struct snd_soc_dai *codec_dai = asoc_rtd_to_codec(rtd, 0);
+	struct snd_soc_dai *cpu_dai = asoc_rtd_to_cpu(rtd, 0);
+	struct s3c_i2sv2_rate_calc div;
+	struct clk *iis_clk;
+	unsigned int mclk;
+	int ret;
+
+	/*
+	 * Limerick's original 2.6 driver uses the S3C2412 "iis" PCLK source,
+	 * with the CPU as I2S master and WM8711 as slave.
+	 */
+	ret = snd_soc_dai_set_sysclk(cpu_dai, S3C2412_CLKSRC_PCLK, 0,
+				     SND_SOC_CLOCK_IN);
+	if (ret < 0)
+		return ret;
+
+	iis_clk = s3c_i2sv2_get_clock(cpu_dai);
+	if (IS_ERR(iis_clk))
+		return PTR_ERR(iis_clk);
+
+	ret = tomtom_calc_rate(&div, params_rate(params), iis_clk);
+	if (ret)
+		return ret;
+
+	/*
+	 * WM8711 only has coefficient entries for nominal standard MCLK/rate
+	 * pairs.  For the TomTom hardware-facing 42968 Hz mode, keep the CPU
+	 * divider calculation at the real rate but present the codec with the
+	 * nominal 44.1k/256fs MCLK identity.  The codec register recipe is the
+	 * original TomTom 44.1k-family setup; ALSA userspace performs 44100 ->
+	 * 42968 resampling before samples reach this DAI.
+	 */
+	if (params_rate(params) == 42968)
+		mclk = 44100 * div.fs_div;
+	else
+		mclk = params_rate(params) * div.fs_div;
+
+	ret = snd_soc_dai_set_sysclk(codec_dai, WM8711_SYSCLK, mclk,
+				     SND_SOC_CLOCK_IN);
+	if (ret < 0)
+		return ret;
+
+	ret = snd_soc_dai_set_clkdiv(cpu_dai, S3C2412_DIV_RCLK, div.fs_div);
+	if (ret < 0)
+		return ret;
+
+	ret = snd_soc_dai_set_clkdiv(cpu_dai, S3C2412_DIV_PRESCALER,
+				     div.clk_div - 1);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
+
+extern void tomtom_audio_set_amp(bool on);
+extern void tomtom_audio_set_dac_power(bool on);
+
+static struct snd_soc_component *tomtom_codec_component;
+
+static int tomtom_speaker_event(struct snd_soc_dapm_widget *w,
+					 struct snd_kcontrol *k, int event)
+{
+	if (SND_SOC_DAPM_EVENT_ON(event)) {
+		unsigned int vol = 117;
+
+		/*
+		 * Hardware oracle: TomTom 2.6 wm8711.c programs this exact
+		 * register image for Limerick before playback.
+		 */
+		if (tomtom_codec_component) {
+			unsigned int cached =
+				snd_soc_component_read(tomtom_codec_component,
+						       WM8711_LOUT1V) & 0x7f;
+
+			if (cached <= 121)
+				vol = cached;
+
+			snd_soc_component_write(tomtom_codec_component,
+						WM8711_LOUT1V, 0x0180 | vol);
+			snd_soc_component_write(tomtom_codec_component,
+						WM8711_APANA, 0x0010);
+			snd_soc_component_write(tomtom_codec_component,
+						WM8711_APDIGI, 0x0000);
+			snd_soc_component_write(tomtom_codec_component,
+						WM8711_PWR, 0x0060);
+			snd_soc_component_write(tomtom_codec_component,
+						WM8711_IFACE, 0x0002);
+			snd_soc_component_write(tomtom_codec_component,
+						WM8711_SRATE, 0x0020);
+			snd_soc_component_write(tomtom_codec_component,
+						WM8711_ACTIVE, 0x0001);
+
+			pr_info("TomTom ASoC: 2.6 WM8711 oracle R2=%03x R4=010 R5=000 R6=060 R7=002 R8=020 R9=001\n",
+				0x0180 | vol);
+		}
+
+		tomtom_audio_set_amp(true);
+		pr_info("TomTom ASoC: speaker amplifier ON\n");
+	} else {
+		tomtom_audio_set_amp(false);
+		pr_info("TomTom ASoC: speaker amplifier OFF\n");
+	}
+
+	return 0;
+}
+
+static const struct snd_soc_dapm_widget tomtom_dapm_widgets[] = {
+	SND_SOC_DAPM_SPK("TomTom Speaker", tomtom_speaker_event),
+};
+
+static const struct snd_soc_dapm_route tomtom_audio_routes[] = {
+	{ "TomTom Speaker", NULL, "LOUT" },
+	{ "TomTom Speaker", NULL, "ROUT" },
+};
+
+
+static int tomtom_wm8711_runtime_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_soc_dai *codec_dai = asoc_rtd_to_codec(rtd, 0);
+	struct snd_soc_component *component = codec_dai->component;
+	const unsigned int vol = 110;
+
+	tomtom_codec_component = component;
+
+	/*
+	 * TomTom's original 2.6 WM8711 driver exposes volume 0..121 and
+	 * explicitly unmutes R5.  The generic 6.1 reset defaults leave
+	 * LOUT/ROUT near the floor, effectively inaudible.
+	 *
+	 * Start conservatively at 110/121 (~11 dB below TomTom max).
+	 * The userspace VOL-/VOL+ controls can adjust this at runtime.
+	 */
+	snd_soc_component_write(component, WM8711_LOUT1V, 0x0100 | vol);
+	snd_soc_component_write(component, WM8711_ROUT1V, 0x0100 | vol);
+	snd_soc_component_update_bits(component, WM8711_APDIGI, 0x0008, 0x0000);
+
+	pr_info("TomTom ASoC: WM8711 startup volume=%u/121, digital unmute\n",
+		vol);
+	return 0;
+}
+
+static const struct snd_soc_ops tomtom_wm8711_ops = {
+	.hw_params = tomtom_wm8711_hw_params,
+};
+
+SND_SOC_DAILINK_DEFS(tomtom_wm8711,
+	DAILINK_COMP_ARRAY(COMP_CPU("s3c2412-iis")),
+	DAILINK_COMP_ARRAY(COMP_CODEC("spi3.0", "wm8711-hifi")),
+	DAILINK_COMP_ARRAY(COMP_PLATFORM("s3c2412-iis")));
+
+static struct snd_soc_dai_link tomtom_wm8711_link = {
+	.name = "TomTom-WM8711",
+	.stream_name = "TomTom PCM",
+	.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+		   SND_SOC_DAIFMT_CBS_CFS,
+	.init = tomtom_wm8711_runtime_init,
+	.ops = &tomtom_wm8711_ops,
+	SND_SOC_DAILINK_REG(tomtom_wm8711),
+};
+
+static struct snd_soc_card tomtom_wm8711_card = {
+	.name = "TomTom-ONE-XL",
+	.owner = THIS_MODULE,
+	.dai_link = &tomtom_wm8711_link,
+	.num_links = 1,
+	.dapm_widgets = tomtom_dapm_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(tomtom_dapm_widgets),
+	.dapm_routes = tomtom_audio_routes,
+	.num_dapm_routes = ARRAY_SIZE(tomtom_audio_routes),
+};
+
+static struct platform_device *tomtom_snd_device;
+
+static int __init tomtom_wm8711_init(void)
+{
+	int ret;
+
+	if (!machine_is_tomtomgo())
+		return 0;
+
+	pr_info("TomTom ONE XL WM8711 ASoC machine driver\n");
+
+	tomtom_snd_device = platform_device_alloc("soc-audio", -1);
+	if (!tomtom_snd_device)
+		return -ENOMEM;
+
+	platform_set_drvdata(tomtom_snd_device, &tomtom_wm8711_card);
+
+	ret = platform_device_add(tomtom_snd_device);
+	if (ret)
+		platform_device_put(tomtom_snd_device);
+
+	return ret;
+}
+module_init(tomtom_wm8711_init);
+
+static void __exit tomtom_wm8711_exit(void)
+{
+	if (tomtom_snd_device)
+		platform_device_unregister(tomtom_snd_device);
+}
+module_exit(tomtom_wm8711_exit);
+
+MODULE_AUTHOR("OpenAI / TomTom 6.1 port");
+MODULE_DESCRIPTION("TomTom ONE XL S3C2412 + WM8711 ASoC machine driver");
+MODULE_LICENSE("GPL");
