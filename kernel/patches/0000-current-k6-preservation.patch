+/*
+ * S3C2412 hardware software reset sequence matching TomTom 2.6 GPL sleep.S.
+ * Per Samsung errata, SYSCLK must be sourced from EXTCLK before SWRST.
+ * We must flush caches, adjust SDRAM refresh for slow clock, switch CLKSRC,
+ * invalidate TLB and caches, pre-fetch instructions into L1 cache,
+ * disable MMU, and write 0x533c2412 directly to physical address 0x4C000030.
+ */
+	.global	s3c2412_cpu_reboot
+
+ENTRY(s3c2412_cpu_reboot)
+	bl	arm926_flush_kern_cache_all
+
+	@ change SDRAM refresh rate for slow clock
+	ldr	r5, =S3C2412_REFRESH
+	ldr	r4, =0x2e
+	str	r4, [ r5 ]	@ store S3C2412_REFRESH
+
+	@ enable slow clock
+	ldr	r5, =S3C2412_CLKSRC
+	ldr	r4, =0
+	str	r4, [ r5 ]	@ store S3C2412_CLKSRC
+
+	mov	r1, #0
+	mcr	p15, 0, r1, c8, c7, 0		@@ invalidate I & D TLBs
+	mcr	p15, 0, r1, c7, c7, 0		@@ invalidate I & D caches
+
+	ldr	r4, =0x4C000030
+	ldr	r7, =0x533C2412
+
+	teq	pc, #0			@ first as a trial-run to load cache
+	bl	s3c2412_do_reboot
+	teq	r0, r0			@ now do it for real
+	b	s3c2412_do_reboot	@
+
+	@@ align next bit of code to cache line
+	.align	8
+s3c2412_do_reboot:
+	mrc	p15, 0, r0, c1, c0, 0
+	bic	r0, r0, #1
+	mcreq	p15, 0, r0, c1, c0, 0
+	streq	r7, [ r4 ]
+1:	beq	1b
+	mov	pc, r14
+ENDPROC(s3c2412_cpu_reboot)
